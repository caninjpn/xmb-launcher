# Copy to keystore.properties (which is gitignored) and fill in.
#
# Create the keystore first:
#
#   keytool -genkeypair -keystore xmb-upload.jks -alias xmb-upload \
#           -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12
#
# storeFile is resolved relative to the project root. Without this file present,
# assembleRelease still works -- it just produces an unsigned APK.

storeFile=xmb-upload.jks
storePassword=
keyAlias=xmb-upload
keyPassword=
